<%-include('../cabecalho.ejs')%>
<h1 class="container-fluid">Adicionar Paciente</h1>
<div class="container-fluid" style="margin-bottom: 24px;">
    <a href="/Paciente/lst" class="btn btn-secondary">Listar</a>
</div>
<div>
    <form method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="nome" class="form-label">Nome</label>
            <input type="text" id="nome" name="nome" class="form-control">
        </div>
        <div class="input-group mb-3">
            <label class="input-group-text" for="foto">Foto</label>
            <input type="file" class="form-control" name="foto" accept="image/png" id="foto">
        </div>
        <div class="mb-3">
            <label for="dataNascimento" class="form-label">Data de Nascimento</label>
            <input type="date" id="dataNascimento" name="dataNascimento" class="form-control">
        </div>
        <div class="mb-3">
            <label for="sus" class="form-label">SUS</label>
            <input type="number" id="sus" name="sus" class="form-control">
        </div>
        <div class="mb-3">
            <label for="cpf" class="form-label">CPF</label>
            <input type="number" id="cpf" name="cpf" class="form-control">
        </div>
        <div class="mb-3">
            <label for="horario" class="form-label">Horário de consulta</label>
            <input type="date" id="horario" name="horario" class="form-control">
        </div>
        <div class="mb-3">
            <label for="posto" class="form-label">Posto de Vacinação</label>
            <input type="text" id="posto" name="posto" class="form-control">
        </div>
        <div class="mb-3">
            <label for="profissional" class="form-label">Profissional</label>
            <select id="profissional" name="profissional" class="form-select form-select-lg mb-3">
                <option selected>Selecione</option>
                <%for (const{id, nome} of Profissional) {%>
                    <option value="<%=id%>"><%=nome%></option>
                <%}%>
            </select>
        </div>
        <div class="mb-3">
            <label for="vacina" class="form-label">Vacina</label>
            <select id="vacina" name="vacina" class="form-select form-select-lg mb-3">
                <option selected>Selecione</option>
                <%for (const{id, nome} of Vacinas) {%>
                    <option value="<%=id%>"><%=nome%></option>
                <%}%>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Cadastrar</button>
    </form>
</div>
<%-include('../rodape.ejs')%>
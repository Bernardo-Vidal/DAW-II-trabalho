<%-include('../cabecalho.ejs')%>
    <h1>Adicionar Paciente</h1>
    <div style="margin-bottom: 24px;">
        <a href="/Paciente/lst" class="btn">Listar</a>
    </div>
    <div>
        <form method="post" enctype="multipart/form-data">
            <label>Nome:</label>
            <input type="text" name="nome"><br>
            <label>Foto:</label>
            <input type="file" name="foto" accept="image/png"><br>
            <label>Data de Nascimento:</label>
            <input type="date" name="dataNascimento"><br>
            <label>Sus:</label>
            <input type="number" name="sus"><br>
            <label>CPF:</label>
            <input type="number" name="cpf"><br>
            <label>Horario de Consulta:</label>
            <input type="date" name="horario"><br>
            <label>Posto de Vacinação</label>
            <input type="text" name="posto"><br>
            <select name="profissional">
                <%for (const{id, nome} of Profissional) {%>
                    <option value="<%=id%>">
                        <%=nome%>
                    </option>
                    <%}%>
            </select>
            <select name="vacina">
                <%for (const{id, nome} of Vacinas) {%>
                    <option value="<%=id%>">
                        <%=nome%>
                    </option>
                    <%}%>
            </select>
            <button type="submit" class="btn submit">Cadastrar</button>
        </form>
    </div>
    <%-include('../rodape.ejs')%>
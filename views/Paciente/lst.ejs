<%-include('../cabecalho.ejs')%>

<div class="container-fluid">
<table class="container-fluid" style="margin-top: 24px">
    <thead>
        <tr style="background: #e9ecef; color: #333">
            <th>Nome</th>
            <th>Foto</th>
            <th>Data de Nascimento</th>
            <th>SUS</th>
            <th>CPF</th>
            <th>Horario de Atendimento</th>
            <th>Posto</th>
            <th>Profissional</th>
            <th>Vacina</th>
            <th colspan="1" style="text-align: center">Ações</th>
        </tr>
    </thead>
    <tbody>
        <nav class="navbar bg-body-tertiary">
            <div class="container-fluid">
                <form class="d-flex flex-row" method="post" role="search">
                    <input class="form-control p-2" type="search" placeholder="Pesquisa" name="Paciente" aria-label="Search"/>
                    <button class="btn btn-outline-success p-2" type="submit">Buscar</button>
                    <button class="btn btn-sm btn-outline-secondary p-2" type="button"><a href="/Paciente/add">Adicionar</a></button>
                </form>
            </div>
        </nav>
        <h1 style="text-align: center; margin-bottom: 32px; color: #333">
            Paciente
        </h1>
        <%for (const{nome, foto, dataNascimento, sus, cpf, horario, posto,
        profissional, vacina, id} of Pacientes) {%>
        <tr>
            <td><%=nome%></td>
            <td>
                <img src="<%=foto%>" width="150" height="150" name="foto" />
            </td>
            <td><%=dataNascimento.toISOString().slice(0,10)%></td>
            <td><%=sus%></td>
            <td><%=cpf%></td>
            <td><%=horario.toISOString().slice(0,10)%></td>
            <td><%=posto%></td>
            <td><%=profissional !=null?profissional.nome:""%></td>
            <td><%=vacina !=null?vacina.nome:""%></td>
            <td>
                <a href="/Paciente/edt/<%=id%>" class="btn btn-warning"
                    ><i class="fa-solid fa-pen">‌</i>&nbsp;Editar</a
                >
                <br /><a
                    href="/Paciente/del/<%=id%>"
                    class="btn btn-danger"
                    onclick="return confirm('Tem certeza que deseja excluir este Paciente?')"
                    ><i class="fa-solid fa-box-archive">‌</i>&nbsp;Excluir</a
                >
            </td>
        </tr>
        <%}%>
    </tbody>
</table>
</div>
<%-include('../rodape.ejs')%>

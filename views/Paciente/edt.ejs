<%-include('../cabecalho.ejs')%>
    <h1>Editar Vacina</h1>
    <div style="margin-bottom: 24px;">
        <a href="/Vacina/lst" class="btn">Listar</a>
    </div>
    <div>
        <form method="post" class="form-visual">
            <label>Nome:</label>
            <input type="text" value="<%=Vacina.nome%>" name="nome"><br>
            <label>Foto:</label>
            <img src="<%=Vacina.foto%>" width="150" height="150" name="foto">
            <input type="file" name="foto" accept="image/png"><br>
            <label>Data de Nascimento:</label>
            <input type="date" value="<%=Vacina.dataNascimento%>" name="dataNascimento"><br>
            <label>Sus:</label>
            <input type="number" value="<%=Vacina.sus%>" name="sus"><br>
            <label>CPF:</label>
            <input type="number" value="<%=Vacina.cpf%>" name="cpf"><br>
            <label>Horario de Consulta:</label>
            <input type="date" value="<%=Vacina.horario%>" name="horario"><br>
            <label>Posto de Vacinação</label>
            <input type="text" value="<%=Vacina.posto%>" name="posto"><br>
            <select name="profissional">
                <%for (const{id, nome} of Profissional) {%>
                    <option value="<%=id%>">
                        <%=nome%>
                    </option>
                    <%}%>
            </select>
            <select name="vacina">
                <%for (const{id, nome} of Vacinas) {%>
                    <option value="<%=id%>">
                        <%=nome%>
                    </option>
                    <%}%>
            </select>
            <button type="submit" class="btn submit">Submeter edição</button>
        </form>
    </div>
    <%-include('../rodape.ejs')%>
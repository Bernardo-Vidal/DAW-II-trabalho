<%-include('../cabecalho.ejs')%>
<h1>Editar Paciente</h1>
<div style="margin-bottom: 24px">
    <a href="/Paciente/lst" class="btn">Listar</a>
</div>
<div>
    <form method="post" class="form-visual">
        <label>Nome:</label>
        <input type="text" value="<%=Paciente.nome%>" name="nome" /><br />
        <label>Foto:</label>
        <img src="<%=Paciente.foto%>" width="150" height="150" name="foto" />
        <input type="file" name="foto" accept="image/png" /><br />
        <label>Data de Nascimento:</label>
        <input
            type="date"
            value="<%=Paciente.dataNascimento%>"
            name="dataNascimento"
        /><br />
        <label>Sus:</label>
        <input type="number" value="<%=Paciente.sus%>" name="sus" /><br />
        <label>CPF:</label>
        <input type="number" value="<%=Paciente.cpf%>" name="cpf" /><br />
        <label>Horario de Consulta:</label>
        <input type="date" value="<%=Paciente.horario%>" name="horario" /><br />
        <label>Posto de Vacinação</label>
        <input type="text" value="<%=Paciente.posto%>" name="posto" /><br />
        <select name="profissional">
            <%for (const{id, nome} of Profissional) {%>
            <option value="<%=id%>"><%=nome%></option>
            <%}%>
        </select>
        <select name="Paciente">
            <%for (const{id, nome} of Vacina) {%>
            <option value="<%=id%>"><%=nome%></option>
            <%}%>
        </select>
        <button type="submit" class="btn submit">Submeter edição</button>
    </form>
</div>
<%-include('../rodape.ejs')%>

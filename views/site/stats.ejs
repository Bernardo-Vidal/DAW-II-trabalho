<%-include('cabecalho.ejs')%>
        <div class="container-fluid text-center">
            <p class="display-1"><b>Pacientes Atendidos</b></p>
                <%var pacientes = 0%>
                <%for(const{id} of Paciente){pacientes++}%>
                <h3 class="display-3">
                    <%=pacientes%>
                </h3>
        </div>
        <div class="container-fluid">
            <div class="accordion" id="accordionPanelsStayOpenExample">
                <h1>Vacinas Disponíveis</h1>
                <%for(const{nome, efetividade} of Vacina){%>
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapse<%=nome%>" aria-expanded="true" aria-controls="panelsStayOpen-collapseOne">
                            <%=nome%>
                        </button>
                    </h2>
                    <div id="panelsStayOpen-collapse<%=nome%>" class="accordion-collapse collapse">
                        <div class="accordion-body">
                                <%var name = nome, tomadas = 0;for(const{id, vacina} of Paciente){%>
                                    <%if(name == vacina.nome){tomadas++}%>
                                <%}%>
                                <div>
                                    <p>Efevidade: <%=efetividade%></p>
                                    <p>Total de vacinações: <%=tomadas%></p>
                                </div>
                        </div>
                    </div>
                </div>
                <%}%>
            </div>
        </div>
<%-include('rodape.ejs')%>
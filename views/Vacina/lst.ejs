<%-include('../cabecalho.ejs')%>
<h1 style="text-align: center; margin-bottom: 32px; color: #333">Vacina</h1>
<a href="/Vacina/add" class="btn add" style="margin-bottom: 32px"
    >Adicionar Vacina</a
>
<table class="curso-table" style="margin-top: 24px">
    <thead>
        <tr style="background: #e9ecef; color: #333">
            <th>Nome</th>
            <th>Efetividade</th>
            <th>Lote</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        <form method="post">
            <label>Pesquisar:</label>
            <input type="text" name="Vacina" /><br />
            <button type="submit" class="btn submit">Procurar</button>
        </form>
        <%for (const{nome, lote, efetividade, id} of Vacinas) {%>
        <tr>
            <td><%=nome%></td>
            <td><%=efetividade%></td>
            <td><%=lote !=null?lote.codigo:""%></td>
            <td>
                <a href="/Vacina/edt/<%=id%>" class="btn edit"
                    ><i class="fa-solid fa-pen">‌</i>&nbsp;Editar</a
                ><br />
                <a
                    href="/Vacina/del/<%=id%>"
                    class="btn delete"
                    onclick="return confirm('Tem certeza que deseja excluir este Vacina?')"
                    ><i class="fa-solid fa-box-archive">‌</i>&nbsp;Excluir
                </a>
            </td>
        </tr>
        <%}%>
    </tbody>
</table>

<%-include('../rodape.ejs')%>

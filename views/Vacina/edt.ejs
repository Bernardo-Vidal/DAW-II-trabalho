<%-include('../cabecalho.ejs')%>
<h1>Editar Vacina</h1>
<div style="margin-bottom: 24px">
    <a href="/Vacina/lst" class="btn">Listar</a>
</div>
<div>
    <form method="post" class="form-visual">
        <label>Nome:</label>
        <input type="text" name="nome" value="<%=Vacina.nome%>" /><br />
        <label>Efetividade:</label>
        <input
            type="text"
            name="efetividade"
            value="<%=Vacina.efetividade%>"
        /><br />
        <label>Lote:</label>
        <select name="lote">
            <%for (const{id, codigo} of Lote) {%>
            <option value="<%=id%>"><%=codigo%></option>
            <%}%>
        </select>
        <button type="submit" class="btn submit">Submeter edição</button>
    </form>
</div>
<%-include('../rodape.ejs')%>

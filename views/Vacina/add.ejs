<%-include('../cabecalho.ejs')%>
<h1>Adicionar Vacina</h1>
<div style="margin-bottom: 24px">
    <a href="/Vacina/lst" class="btn">Listar</a>
</div>
<div>
    <form method="post">
        <label>Nome:</label>
        <input type="text" name="nome" /><br />
        <label>Efetividade:</label>
        <input type="text" name="efetividade" /><br />
        <label>Lote:</label>
        <select name="lote">
            <%for (const{id, codigo} of Lotes) {%>
            <option value="<%=id%>"><%=codigo%></option>
            <%}%>
        </select>
        <button type="submit" class="btn submit">Cadastrar</button>
    </form>
</div>
<%-include('../rodape.ejs')%>

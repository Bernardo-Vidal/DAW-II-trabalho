<%-include('../cabecalho.ejs')%>
<h1>Editar Lote</h1>
<div style="margin-bottom: 24px">
    <a href="/Lote/lst" class="btn">Listar</a>
</div>
<div>
    <form method="post" class="form-visual">
        <label>Validade:</label>
        <input
            type="date"
            name="validade"
            value="<%=Lote.validade%>"
            required
        /><br />
        <label>Código:</label>
        <input type="text" name="codigo" value="<%=Lote.codigo%>" /><br />
        <label>Laboratório:</label>
        <select name="laboratorio">
            <%for (const{id, nome} of Laboratorio) {%>
            <option value="<%=id%>"><%=nome%></option>
            <%}%>
        </select>
        <button type="submit" class="btn submit">Submeter edição</button>
    </form>
</div>
<%-include('../rodape.ejs')%>

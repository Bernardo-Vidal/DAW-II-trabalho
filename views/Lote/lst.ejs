<%-include('../cabecalho.ejs')%>
<div class="container-fluid">
<table class="container-fluid" style="margin-top: 24px">
    <thead>
        <tr style="background: #e9ecef; color: #333">
            <th>Validade</th>
            <th>Código</th>
            <th>Laboratório</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        <nav class="navbar bg-body-tertiary">
            <div class="container-fluid">
                <form class="d-flex flex-row" method="post" role="search">
                    <input class="form-control p-2" type="search" placeholder="Pesquisa" name="Lote" aria-label="Search"/>
                    <button class="btn btn-outline-success p-2" type="submit">Buscar</button>
                    <button class="btn btn-sm btn-outline-secondary p-2" type="button"><a href="/Lote/add">Adicionar</a></button>
                </form>
            </div>
        </nav>
        <h1 style="text-align: center; margin-bottom: 32px; color: #333">
            Lote
        </h1>
        <%for (const{validade, codigo, laboratorio, id} of Lotes) {%>
        <tr>
            <td><%=validade.toISOString().slice(0,10)%></td>
            <td><%=codigo%></td>
            <td><%=laboratorio !=null?laboratorio.nome:""%></td>
            <td>
                <a href="/Lote/edt/<%=id%>" class="btn btn-warning"
                    ><i class="fa-solid fa-pen">‌</i>&nbsp;Editar</a
                >
                <br />
                <a
                    href="/Lote/del/<%=id%>"
                    class="btn btn-danger"
                    onclick="return confirm('Tem certeza que deseja excluir este Lote?')"
                    ><i class="fa-solid fa-box-archive">‌</i>&nbsp;Excluir</a
                >
            </td>
        </tr>
        <%}%>
    </tbody>
</table>
</div>
<%-include('../rodape.ejs')%>

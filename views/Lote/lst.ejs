<%-include('../cabecalho.ejs')%>
<h1 style="text-align: center; margin-bottom: 32px; color: #333">Lote</h1>
<a href="/Lote/add" class="btn add" style="margin-bottom: 32px"
    >Adicionar Lote</a
>
<table class="curso-table" style="margin-top: 24px">
    <thead>
        <tr style="background: #e9ecef; color: #333">
            <th>Validade</th>
            <th>Código</th>
            <th>Laboratório</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        <form method="post">
            <label>Pesquisar:</label>
            <input type="text" name="Lote" /><br />
            <button type="submit" class="btn submit">Procurar</button>
        </form>
        <%for (const{validade, codigo, laboratorio, id} of Lotes) {%>
        <tr>
            <td><%=validade.toISOString().slice(0,10)%></td>
            <td><%=codigo%></td>
            <td><%=laboratorio !=null?laboratorio.nome:""%></td>
            <td>
                <a href="/Lote/edt/<%=id%>" class="btn edit"
                    ><i class="fa-solid fa-pen">‌</i>&nbsp;Editar</a
                >
                <br />
                <a
                    href="/Lote/del/<%=id%>"
                    class="btn delete"
                    onclick="return confirm('Tem certeza que deseja excluir este Lote?')"
                    ><i class="fa-solid fa-box-archive">‌</i>&nbsp;Excluir</a
                >
            </td>
        </tr>
        <%}%>
    </tbody>
</table>

<%-include('../rodape.ejs')%>

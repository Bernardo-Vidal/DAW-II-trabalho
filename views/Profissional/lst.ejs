<%-include('../cabecalho.ejs')%>
<h1 style="text-align: center; margin-bottom: 32px; color: #333">
    Profissional
</h1>
<a href="/Profissional/add" class="btn add" style="margin-bottom: 32px"
    >Adicionar Profissional</a
>
<table class="curso-table" style="margin-top: 24px">
    <thead>
        <tr style="background: #e9ecef; color: #333">
            <th>Nome</th>
            <th>Foto</th>
            <th>CRM</th>
            <th>Cargo</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        <form method="post">
            <label>Pesquisar:</label>
            <input type="text" name="Profissional" /><br />
            <button type="submit" class="btn submit">Procurar</button>
        </form>
        <%for (const{nome, foto, crm, cargo, id} of Profissional) {%>
        <tr>
            <td><%=nome%></td>
            <td>
                <img src="<%=foto%>" width="150" height="150" />
            </td>
            <td><%=crm%></td>
            <td><%=cargo%></td>
            <td>
                <a href="/Profissional/edt/<%=id%>" class="btn edit"
                    ><i class="fa-solid fa-pen">‌</i>&nbsp;Editar </a
                ><br />
                <a
                    href="/Profissional/del/<%=id%>"
                    class="btn delete"
                    onclick="return confirm('Tem certeza que deseja excluir este Profissional?')"
                    ><i class="fa-solid fa-box-archive">‌</i>&nbsp;Excluir
                </a>
            </td>
        </tr>
        <%}%>
    </tbody>
</table>

<%-include('../rodape.ejs')%>

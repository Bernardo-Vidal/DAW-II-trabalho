<%-include('../cabecalho.ejs')%>
<h1>Editar Profissional</h1>
<div style="margin-bottom: 24px">
    <a href="/Profissional/lst" class="btn">Listar</a>
</div>
<div>
    <form method="post" class="form-visual" enctype="multipart/form-data">
        <label>Nome do Profissional:</label>
        <input type="text" name="nome" value="<%= Profissional.nome %>" /><br />
        <label>Foto:</label>
        <img src="<%=Profissional.foto%>" width="150" height="150" /><br />
        <input
            type="file"
            accept="image/png"
            value="<%=Profissional.foto%>"
            name="foto"
        /><br />
        <label>CRM:</label>
        <input type="text" name="crm" value="<%=Profissional.crm%>" /><br />
        <label>Cargo:</label>
        <input type="text" name="cargo" value="<%=Profissional.cargo%>" /><br />
        <button type="submit" class="btn submit">Submeter edição</button>
    </form>
</div>
<%-include('../rodape.ejs')%>

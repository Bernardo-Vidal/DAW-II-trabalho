<%-include('../cabecalho.ejs')%>
<h1 class="container-fluid">Editar Profissional</h1>
<div class="container-fluid" style="margin-bottom: 24px">
    <a href="/Profissional/lst" class="btn btn-secondary">Listar</a>
</div>
<div>
    <form method="post" enctype="multipart/form-data">
        <div class="input-group mb-3">
            <img src="<%=Profissional.foto%>" class="rounded float-start" width="100" height="100">
        </div>
        <div class="mb-3">
            <label for="nome" class="form-label">Nome</label>
            <input value="<%=Profissional.nome%>" type="text" id="nome" name="nome" class="form-control">
        </div>
        <div class="input-group mb-3">
            <label class="input-group-text" for="foto">Foto</label>
            <input type="file" value="<%=Profissional.foto%>" class="form-control" name="foto" accept="image/png" id="foto">
        </div>
        <div class="mb-3">
            <label for="cargo" class="form-label">Cargo</label>
            <input value="<%=Profissional.cargo%>" type="text" id="cargo" name="cargo" class="form-control">
        </div>
        <div class="mb-3">
            <label for="crm" class="form-label">CRM</label>
            <input value="<%=Profissional.crm%>" type="text" id="crm" name="crm" class="form-control">
        </div>
        <button type="submit" class="btn btn-primary">Cadastrar</button>
    </form>
</div>
<%-include('../rodape.ejs')%>

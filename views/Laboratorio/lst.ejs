<%-include('../cabecalho.ejs')%>
<div class="container-fluid">

<table class="container-fluid" style="margin-top: 24px">
    <thead>
        <tr style="background: #e9ecef; color: #333">
            <th>Nome</th>
            <th>Email</th>
            <th>Endereco</th>
            <th>Logo</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        
        <nav class="navbar bg-body-tertiary">
            <div class="container-fluid">
                <form class="d-flex flex-row" method="post" role="search">
                    <input class="form-control p-2" type="search" placeholder="Pesquisa" name="Laboratorio" aria-label="Search"/>
                    <button class="btn btn-outline-success p-2" type="submit">Buscar</button>
                    <button class="btn btn-sm btn-outline-secondary p-2" type="button"><a href="/Laboratorio/add">Adicionar</a></button>
                </form>
            </div>
        </nav>
        <h1 style="text-align: center; margin-bottom: 32px; color: #333">
            Laboratorio
        </h1>
        <%for (const{id, nome, endereco, email, logo} of Laboratorios) {%>
        <tr>
            <td><%=nome%></td>
            <td><%=endereco%></td>
            <td><%=email%></td>
            <td>
                <img src="<%=logo%>" width="150" height="150" name="logo" />
            </td>
            <td>
                <a href="/Laboratorio/edt/<%=id%>" class="btn btn-warning"
                    ><i class="fa-solid fa-pen">‌</i>&nbsp;Editar</a
                ><br />
                <a
                    href="/Laboratorio/del/<%=id%>"
                    class="btn btn-danger"
                    onclick="return confirm('Tem certeza que deseja excluir este Laboratorio?')"
                    ><i class="fa-solid fa-box-archive">‌</i>&nbsp;Excluir</a
                >
            </td>
        </tr>
        <%}%>
    </tbody>
</table>
</div>
<%-include('../rodape.ejs')%>
